# ============================================================================
# Aangan Studio dashboard — environment variables
# Copy to .env.local for local work; set the same names in Vercel → Project → Settings → Environment Variables.
# ============================================================================

# --- Supabase (required in production; leave unset locally to run in demo mode with the 40 real enquiries) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Bypasses RLS. NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (required for live call/message processing) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Dashboard logins (HTTP Basic auth). REQUIRED in production — the app refuses to serve without them. ---
# Designers + front desk: the full working tool (transcripts, escalations, briefs, emails).
DESIGNER_USER=designer
DESIGNER_PASSWORD=
# Nikhil: end results only — aggregate numbers, never transcripts or client details.
FOUNDER_USER=nikhil
FOUNDER_PASSWORD=

# PUBLIC_VIEW=true lets anyone READ the designer screens with no login (buttons still need the designer login).
# Only for demos / sample data — it exposes client names and transcripts to anyone with the link. Default: off.
# PUBLIC_VIEW=false
# PUBLIC_EDIT=true removes the login entirely: anyone with the link can read AND press every button. Demo / sample data only. Default: off.
# PUBLIC_EDIT=false

# --- Ingest webhooks (telephony / WhatsApp / web form call these) ---
# Sent as:  Authorization: Bearer <INGEST_API_KEY>      Generate with: openssl rand -hex 32
INGEST_API_KEY=
# Same secret protects /api/cron/sla-check (Vercel Cron sends it automatically as CRON_SECRET)
CRON_SECRET=

# --- Guardrail tuning (all optional; defaults shown) ---
# CONFIDENCE_THRESHOLD=0.85
# AUDIT_SAMPLE_RATE=0.1
# HIGH_VALUE_BUDGET_INR=1500000
# HIGH_VALUE_AREA_SQFT=2000
# SLA_BREACH_HOURS=24
# BUDGET_CLEARLY_BELOW_RATIO=0.5

# --- Notifications (all optional; nothing is sent when unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_FRONT_DESK=
TELEGRAM_CHAT_ID_FOUNDER=
TELEGRAM_CHAT_ID_DESIGNERS=
ALERT_EMAIL_FRONT_DESK=
ALERT_EMAIL_FOUNDER=
ALERT_EMAIL_DESIGNERS=

# --- Email to enquirers (client confirmation / clarification / decline) ---
RESEND_API_KEY=
MAIL_FROM="Aangan Studio <hello@yourdomain.com>"
# dry_run (default) logs + records the email but sends nothing. Set to "live" to really send.
CLIENT_EMAIL_MODE=dry_run
# Auto-send the confirmation email as soon as a lead is qualified and a designer is assigned. Default: designer reviews and clicks Send.
AUTO_SEND_CLIENT_EMAIL=false
STUDIO_PHONE=
STUDIO_EMAIL=
STUDIO_ADDRESS=
STUDIO_HOURS="Monday to Saturday, 10:00 am – 7:00 pm"

# --- HubSpot CRM (optional) ---
# HubSpot SERVICE KEY (Development → Keys → Service Keys; legacy private apps are retired) with scopes
# crm.objects.contacts.read/write and crm.objects.deals.read/write. Verify: npm run hubspot:check
HUBSPOT_ACCESS_TOKEN=
# HUBSPOT_PIPELINE_ID=default
# HUBSPOT_STAGE_NEW=appointmentscheduled
# HUBSPOT_STAGE_QUALIFIED=qualifiedtobuy
# HUBSPOT_STAGE_CONSULTATION=presentationscheduled
# HUBSPOT_STAGE_WON=closedwon
# HUBSPOT_STAGE_LOST=closedlost

# --- Google Calendar sync (optional; consultations work without it and clients always get an .ics) ---
# PREFERRED: a service account (never expires). Paste the downloaded key file (raw JSON or base64) and the ID of the studio
# calendar you SHARED with the service account email ("Make changes to events"). Verify: npm run calendar:check
GOOGLE_SERVICE_ACCOUNT_JSON=
# (service accounts cannot invite attendees; the designer is named in the event description instead)
# ALTERNATIVE: OAuth as a user (can invite attendees, but refresh tokens of apps in "Testing" mode expire after 7 days):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# true = Google emails the CLIENT an invite too. Default false: the client gets the .ics in the reviewed confirmation email.
GOOGLE_INVITE_CLIENT=false

# --- Vaani Voice (vaanivoice.ai) — polled via API, no webhooks. Verify: npm run voice:check ---
VAANI_API_KEY=
# VAANI_BASE_URL=https://api.vaanivoice.ai
# VAANI_INCLUDE_OUTBOUND=false
# Comma-separated hosts the app may download call recordings from (SSRF guard); transcripts normally make this unnecessary.
VOICE_RECORDING_HOSTS=

# --- Demo mode only ---
# DEMO_SYNTHETIC=160   # pad the in-memory demo month with simulated (flagged) enquiries
